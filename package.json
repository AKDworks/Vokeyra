{
  "name": "vokeyra",
  "version": "0.3.0",
  "description": "Private, local speech to text for your desktop",
  "license": "MIT",
  "author": "AKDworks",
  "homepage": "https://github.com/AKDworks/Vokeyra#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/AKDworks/Vokeyra.git"
  },
  "bugs": {
    "url": "https://github.com/AKDworks/Vokeyra/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/tauri.mjs dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && node scripts/build-tauri.mjs",
    "start": "node scripts/tauri.mjs dev",
    "tauri": "node scripts/tauri.mjs",
    "pack:win": "node scripts/package-tauri.mjs --no-bundle",
    "dist:win": "node scripts/package-tauri.mjs --bundles nsis",
    "pack:linux": "node scripts/package-tauri.mjs --no-bundle",
    "dist:linux": "node scripts/package-tauri.mjs --bundles deb,appimage",
    "dist:linux:unsigned": "node scripts/package-tauri.mjs --unsigned --bundles deb,appimage",
    "smoke": "node scripts/smoke-tauri.mjs",
    "smoke:service": "node scripts/smoke-service.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "onnxruntime-node": "1.22.0",
    "sherpa-onnx-node": "^1.13.8",
    "tar": "^7.5.22"
  }
}
